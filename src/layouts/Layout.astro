---
import "../index.css";

interface Props {
  title?: string;
}

const { title = "Tharun Balaji — Frontend Engineer" } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const description =
  "Frontend engineer portfolio for Tharun Balaji featuring shipped projects, engineering perspective, experience, writing, and contact details.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090e" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={`${assetBase}logo512.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="manifest" href={`${assetBase}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${assetBase}logo192.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import { registerSW } from "virtual:pwa-register";

      registerSW({ immediate: true });
    </script>
  </body>
</html>
