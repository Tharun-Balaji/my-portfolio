---
import "../index.css";
import "../vars.css";
import "@fontsource/outfit";
import "@fontsource/roboto";
import styles from "../App.module.css";

interface Props {
  title?: string;
}

const { title = "Portfolio" } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="manifest" href={`${assetBase}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${assetBase}logo192.png`} />
    <title>{title}</title>
  </head>
  <body class={styles.App}>
    <slot />
    <script>
      import { registerSW } from "virtual:pwa-register";

      registerSW({ immediate: true });
    </script>
  </body>
</html>
