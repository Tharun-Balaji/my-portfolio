---
import styles from "./ProjectCard.module.css";
import { assetPath } from "../../utils/assets";
import type { Project } from "../../types/content";

const { project } = Astro.props as { project: Project };
---

<div class={styles.container}>
  <img src={assetPath(project.imageSrc)} alt={`ImageOf ${project.title}`} class={styles.image} />
  <h3 class={styles.title}>{project.title}</h3>
  <p class={styles.description}>{project.description}</p>
  <ul class={styles.skills}>
    {project.skills.map((skill: string) => <li class={styles.skill}>{skill}</li>)}
  </ul>
  <div class={styles.links}>
    <a target="_blank" rel="noopener noreferrer" class={styles.link} href={project.demo}> Demo </a>
    <a target="_blank" rel="noopener noreferrer" class={styles.link} href={project.source}>
      Source
    </a>
  </div>
</div>
