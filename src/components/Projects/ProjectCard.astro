---
import { assetPath } from "../../utils/assets";
import type { Project } from "../../types/content";

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props as Props;

const formatTitle = (value: string) =>
  value
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/[-_]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
---

<article class={`terminal-panel project-card ${featured ? "project-card--wide" : ""}`} data-reveal="up">
  <div class="panel-header">
    <span>RECORD // {String(index + 1).padStart(3, "0")}</span>
    <span>LIVE_ARCHIVE</span>
  </div>

  <div class="project-card__media">
    <img
      src={assetPath(project.imageSrc)}
      alt={`Preview of ${formatTitle(project.title)}`}
      loading="lazy"
      decoding="async"
    />
    <div class="project-card__overlay"></div>
  </div>

  <div class="project-card__body">
    <div class="chip-row">
      {
        project.skills.slice(0, 3).map((skill) => (
          <span class="chip chip--secondary">{skill}</span>
        ))
      }
    </div>

    <h3>{formatTitle(project.title)}</h3>
    <p>{project.description}</p>

    <div class="project-card__footer">
      <a
        class="inline-link"
        href={project.demo}
        rel="noopener noreferrer"
        target="_blank"
      >
        OPEN_DEMO
      </a>
      <a
        class="inline-link"
        href={project.source}
        rel="noopener noreferrer"
        target="_blank"
      >
        SOURCE_MAP
      </a>
    </div>
  </div>
</article>
