---
import { assetPath } from "../../utils/assets";

const { project } = Astro.props;
---

<article class="flex h-full flex-col rounded-xl border-2 border-neon-cyan/70 bg-neon-ink p-4">
  <img
    src={assetPath(project.imageSrc)}
    alt={`Preview of ${project.title}`}
    class="h-44 w-full rounded-lg border border-neon-pink object-cover"
    loading="lazy"
    decoding="async"
  />
  <h3 class="mt-4 text-lg font-bold text-neon-lime">{project.title}</h3>
  <p class="mt-2 text-sm text-neon-cream/95">{project.description}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      project.skills.map((skill) => (
        <li class="rounded-full border border-neon-yellow/80 px-2 py-1 text-xs text-neon-cream">
          {skill}
        </li>
      ))
    }
  </ul>
  <div class="mt-4 flex gap-3 pt-2">
    <a
      target="_blank"
      rel="noopener noreferrer"
      class="retro-btn px-3 py-2 text-xs"
      href={project.demo}
    >
      Demo
    </a>
    <a
      target="_blank"
      rel="noopener noreferrer"
      class="retro-btn retro-btn-alt px-3 py-2 text-xs"
      href={project.source}
    >
      Source
    </a>
  </div>
</article>
