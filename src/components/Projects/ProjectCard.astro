---
import { assetPath } from "../../utils/assets";
import type { Project } from "../../types/content";

interface Props {
  project: Project;
  record: string;
  variant: "primary" | "secondary";
}

const { project, record, variant } = Astro.props as Props;
---

{
  variant === "primary" ? (
    <article class="terminal-panel reveal-item">
      <div class="terminal-header">
        <span>{`Project // ${record}`}</span>
      </div>
      <div class="project-hero-media">
        <img
          src={assetPath(project.imageSrc)}
          alt={`Preview of ${project.title}`}
          loading="lazy"
          decoding="async"
        />
        <div class="project-hero-overlay"></div>
      </div>
      <div class="project-card-body">
        <div class="project-meta">
          {project.skills.slice(0, 2).map((skill) => <span class="meta-chip">{skill}</span>)}
        </div>
        <h3>{project.title.toUpperCase()}</h3>
        <p>{project.description}</p>
        <a
          class="panel-link"
          href={project.demo}
          rel="noopener noreferrer"
          target="_blank"
        >
          View Project
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </article>
  ) : (
    <article class="terminal-panel project-mini-card reveal-item">
      <div class="terminal-header project-mini-card__header">
        <span>{`Project // ${record}`}</span>
      </div>
      <div class="project-mini-card__body">
        <div class="mini-panel">
          <span class="material-symbols-outlined">analytics</span>
        </div>
        <h3>{project.title.toUpperCase()}</h3>
        <p>{project.description}</p>
      </div>
      <div class="project-mini-card__footer">
        <span>Source Available</span>
        <a
          class="project-mini-card__link"
          href={project.source}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`Open source for ${project.title}`}
        >
          <span class="material-symbols-outlined">north_east</span>
        </a>
      </div>
    </article>
  )
}
