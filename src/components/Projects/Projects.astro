---
import projects from "../../data/projects.json";
import ProjectCard from "./ProjectCard.astro";

const primaryProject =
  projects.find((project) => project.title === "Book My Show Clone") ?? projects[0];
const secondaryProject =
  projects.find((project) => project.title === "Mern-chat-app") ?? projects[1];
---

<section class="section-shell section-gap" id="projects">
  <div class="section-head">
    <h2>PROJECT_LOGS</h2>
    <div class="section-line"></div>
  </div>

  <div class="project-grid">
    <ProjectCard project={primaryProject} variant="primary" record="001_BMS" />
    <ProjectCard project={secondaryProject} variant="secondary" record="002_CHAT" />
  </div>
</section>
