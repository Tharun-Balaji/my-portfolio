---
import projectsData from "../../data/projects.json";
import type { Project } from "../../types/content";
import ProjectCard from "./ProjectCard.astro";
---

<section class="px-4 py-10 sm:px-6 lg:px-10" id="projects" data-reveal="right">
  <div
    class="mx-auto w-full max-w-6xl rounded-2xl border-2 border-neon-yellow bg-neon-ink/90 p-6 shadow-card lg:p-10"
  >
    <h2 class="font-display text-2xl uppercase text-neon-yellow sm:text-3xl">Projects</h2>
    <p class="mt-2 max-w-3xl text-sm text-neon-cream/90 sm:text-base">
      Selected work across frontend apps, full-stack products, and experiments in interaction-heavy
      experiences.
    </p>
    <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
