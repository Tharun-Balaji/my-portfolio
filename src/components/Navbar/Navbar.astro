---
const links = [
  { label: "PROJECTS", href: "#projects", serial: "001" },
  { label: "SKILLS", href: "#stack", serial: "002" },
  { label: "HISTORY", href: "#experience", serial: "003" },
  { label: "RESEARCH", href: "#writing", serial: "004" },
  { label: "CONTACT", href: "#contact", serial: "005" },
];
---

<nav class="glass-nav" aria-label="Main navigation" data-reveal="down">
  <div class="nav-shell">
    <a class="nav-brand" href="#hero">
      <span class="nav-brand__icon">
        <span class="material-symbols-outlined">hexagon</span>
      </span>
      <span>KINETIC<span class="nav-brand__dot">.</span>ENG</span>
    </a>

    <div class="nav-actions">
      <a class="resume-button touch-target" href="#contact">RESUME</a>

      <button
        class="menu-toggle touch-target"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu-overlay"
        aria-label="Open navigation menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true">
  <div class="mobile-menu-overlay__inner">
    <div class="mobile-menu-overlay__intro">
      <span>SYSTEM_INDEX</span>
      <div></div>
    </div>

    <nav class="mobile-menu-links">
      {
        links.map((link) => (
          <a class="nav-link-item mobile-link" data-nav-link href={link.href}>
            <span>{link.label}</span>
            <span class="label-mono">{link.serial}</span>
          </a>
        ))
      }
    </nav>

    <div class="mobile-menu-overlay__meta">
      <div class="mobile-meta-card">
        <span>GEO_HUB</span>
        <strong>COIMBATORE</strong>
      </div>
      <div class="mobile-meta-card">
        <span>STATUS</span>
        <strong>ACTIVE</strong>
      </div>
    </div>
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const menuOverlay = document.getElementById("mobile-menu-overlay");
    const mobileLinks = Array.from(document.querySelectorAll<HTMLElement>(".mobile-link"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("section[id], footer[id]"));

    const toggleMenu = (forceState?: boolean) => {
      const nextState =
        typeof forceState === "boolean"
          ? forceState
          : menuToggle?.getAttribute("aria-expanded") !== "true";

      menuToggle?.setAttribute("aria-expanded", String(nextState));
      menuToggle?.classList.toggle("is-open", nextState);
      menuOverlay?.classList.toggle("is-open", nextState);
      menuOverlay?.setAttribute("aria-hidden", String(!nextState));
      document.body.classList.toggle("nav-open", nextState);
    };

    menuToggle?.addEventListener("click", () => toggleMenu());
    mobileLinks.forEach((link) => link.addEventListener("click", () => toggleMenu(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        toggleMenu(false);
      }
    });

    const updateActiveSection = () => {
      let current = "";

      sections.forEach((section) => {
        if (window.scrollY >= section.offsetTop - 150) {
          current = section.getAttribute("id") || current;
        }
      });

      mobileLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === `#${current}`;
        link.classList.toggle("active", isActive);
      });
    };

    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("resize", updateActiveSection);
    updateActiveSection();
  });
</script>
