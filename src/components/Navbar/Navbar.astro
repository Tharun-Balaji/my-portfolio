---
const links = [
  { label: "Work", href: "#projects" },
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Skills", href: "#skills" },
  { label: "Writing", href: "#writing" },
];
---

<nav class="site-nav" aria-label="Main navigation" data-reveal="down">
  <div class="site-nav__inner shell shell--pill">
    <a class="site-nav__logo" href="#home">Tharun Balaji<span>.</span></a>

    <div class="site-nav__links">
      {
        links.map((item) => (
          <a class="site-nav__link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="button button--primary site-nav__cta" href="#contact">Let's Talk -&gt;</a>
    </div>

    <details class="site-nav__menu">
      <summary>Menu</summary>
      <div class="site-nav__menu-panel">
        {
          links.map((item) => (
            <a class="site-nav__menu-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
        <a class="button button--primary site-nav__menu-cta" href="#contact">Let's Talk -&gt;</a>
      </div>
    </details>
  </div>
</nav>
