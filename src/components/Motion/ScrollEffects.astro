<canvas id="hero-canvas" aria-hidden="true"></canvas>

<div id="loader">
  <div class="loader-panel">
    <div class="loader-panel__header">
      <span>BOOT_LOG</span>
      <span>V5.1.0_PRO</span>
    </div>
    <div class="loader-output" id="terminal-output"></div>
    <div class="loader-progress">
      <div id="loader-progress"></div>
    </div>
  </div>
</div>

<button class="scroll-top" id="scroll-top" type="button" aria-label="Scroll to top">
  TOP
</button>

<script>
  import * as THREE from "three";

  window.addEventListener("DOMContentLoaded", () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const logs = [
      "BOOTING_OS...",
      "VULKAN_INIT",
      "SYNC_NEURAL: 100%",
      "DECRYPT_RESUME...",
      "GRID_CONN: OK",
      "WELCOME_THARUN",
    ];
    const output = document.getElementById("terminal-output");
    const loader = document.getElementById("loader");
    const progress = document.getElementById("loader-progress");
    const topButton = document.getElementById("scroll-top");
    const revealItems = document.querySelectorAll<HTMLElement>(".reveal-item, [data-reveal]");
    const canvas = document.getElementById("hero-canvas");

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );

    revealItems.forEach((item) => revealObserver.observe(item));

    const updateTopButton = () => {
      if (!(topButton instanceof HTMLElement)) {
        return;
      }

      topButton.classList.toggle("is-visible", window.scrollY > 180);
    };

    window.addEventListener("scroll", updateTopButton, { passive: true });
    topButton?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
    updateTopButton();

    const startLoading = async () => {
      const skipLoader = reduceMotion || window.sessionStorage.getItem("portfolio-booted") === "true";

      if (!(output instanceof HTMLElement) || !(progress instanceof HTMLElement) || skipLoader) {
        loader?.classList.add("is-hidden");
        document.body.classList.remove("is-loading");
        window.sessionStorage.setItem("portfolio-booted", "true");
        window.setTimeout(() => loader?.remove(), 500);
        return;
      }

      for (const [index, line] of logs.entries()) {
        const row = document.createElement("div");
        row.className = "loader-line";
        row.innerHTML = `<span>${String(index + 1).padStart(2, "0")}</span><span>${line}</span>`;
        output.appendChild(row);
        requestAnimationFrame(() => row.classList.add("is-visible"));
        progress.style.width = `${((index + 1) / logs.length) * 100}%`;
        await new Promise((resolve) => window.setTimeout(resolve, 150));
      }

      window.sessionStorage.setItem("portfolio-booted", "true");
      window.setTimeout(() => {
        loader?.classList.add("is-hidden");
        document.body.classList.remove("is-loading");
        window.setTimeout(() => loader?.remove(), 700);
      }, 400);
    };

    if (canvas instanceof HTMLCanvasElement && !reduceMotion) {
      try {
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
          70,
          window.innerWidth / window.innerHeight,
          0.1,
          1000,
        );
        camera.position.z = 6;

        const torusGroup = new THREE.Group();
        scene.add(torusGroup);

        const torus = new THREE.Mesh(
          new THREE.TorusGeometry(3.5, 0.7, 30, 100),
          new THREE.MeshBasicMaterial({
            color: 0xa855f7,
            wireframe: true,
            transparent: true,
            opacity: 0.08,
          }),
        );
        torusGroup.add(torus);

        const particlePositions = Array.from({ length: 2400 }, () => (Math.random() - 0.5) * 25);
        const particles = new THREE.Points(
          new THREE.BufferGeometry().setAttribute(
            "position",
            new THREE.Float32BufferAttribute(particlePositions, 3),
          ),
          new THREE.PointsMaterial({
            size: 0.02,
            color: 0x06b6d4,
            transparent: true,
            opacity: 0.15,
          }),
        );
        scene.add(particles);

        const resize = () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        };

        const animate = () => {
          torus.rotation.x += 0.001;
          torus.rotation.y += 0.0008;
          particles.rotation.y -= 0.0001;
          torusGroup.position.y = -window.scrollY * 0.001;
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };

        resize();
        window.addEventListener("resize", resize);
        animate();
      } catch {
        canvas.style.display = "none";
      }
    }

    startLoading();
  });
</script>
