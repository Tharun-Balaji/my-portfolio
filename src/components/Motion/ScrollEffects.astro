<section aria-hidden="true" class="shell-effects">
  <div class="scroll-progress" id="scroll-progress"></div>
  <div class="shell-effects__grid"></div>
  <div class="shell-effects__vignette"></div>
  <div class="shell-effects__orb shell-effects__orb--primary"></div>
  <div class="shell-effects__orb shell-effects__orb--secondary"></div>
  <div class="shell-effects__ring shell-effects__ring--one"></div>
  <div class="shell-effects__ring shell-effects__ring--two"></div>
</section>

<div class="boot-loader" id="boot-loader">
  <div class="boot-loader__panel terminal-panel terminal-panel--strong">
    <div class="panel-header">
      <span>BOOT_LOG // KINETIC_INIT</span>
      <span>RUNTIME 2.6</span>
    </div>
    <div class="boot-loader__body">
      <div class="boot-loader__output" id="boot-output"></div>
      <div class="boot-loader__progress">
        <div class="boot-loader__progress-bar" id="boot-progress"></div>
      </div>
    </div>
  </div>
</div>

<button
  class="scroll-top"
  id="scroll-top"
  type="button"
  aria-label="Scroll to top"
>
  TOP
</button>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const progressBar = document.getElementById("scroll-progress");
    const loader = document.getElementById("boot-loader");
    const output = document.getElementById("boot-output");
    const bootProgress = document.getElementById("boot-progress");
    const topButton = document.getElementById("scroll-top");
    const revealTargets = document.querySelectorAll("[data-reveal]");
    const bootLines = [
      "SYNCING_PORTFOLIO_SIGNAL...",
      "INDEXING_PROJECT_LOGS...",
      "LOADING_STACK_TELEMETRY...",
      "VERIFYING_CONTACT_CHANNELS...",
      "TERMINAL_SURFACE_READY.",
    ];

    const markReady = () => {
      document.body.classList.remove("is-loading");
      loader?.classList.add("is-hidden");
      window.setTimeout(() => loader?.remove(), 650);
    };

    const runLoader = async () => {
      const alreadyBooted = window.sessionStorage.getItem("portfolio-booted") === "true";
      if (!output || !bootProgress || reduceMotion || alreadyBooted) {
        markReady();
        window.sessionStorage.setItem("portfolio-booted", "true");
        return;
      }

      for (const [index, line] of bootLines.entries()) {
        const row = document.createElement("div");
        row.className = "boot-loader__line";
        row.innerHTML = `<span>${String(index + 1).padStart(2, "0")}</span><span>${line}</span>`;
        output.appendChild(row);
        window.requestAnimationFrame(() => row.classList.add("is-visible"));
        bootProgress.style.width = `${((index + 1) / bootLines.length) * 100}%`;
        await new Promise((resolve) => window.setTimeout(resolve, 170));
      }

      window.sessionStorage.setItem("portfolio-booted", "true");
      window.setTimeout(markReady, 360);
    };

    if (revealTargets.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18 },
      );

      revealTargets.forEach((target) => observer.observe(target));
    }

    const onScroll = () => {
      const scrollTop = window.scrollY;
      const maxScroll = Math.max(document.body.scrollHeight - window.innerHeight, 1);
      const ratio = Math.min(scrollTop / maxScroll, 1);

      if (progressBar) {
        progressBar.style.width = `${ratio * 100}%`;
      }

      if (topButton) {
        topButton.classList.toggle("is-visible", scrollTop > 160);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    topButton?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });

    onScroll();
    runLoader();
  });
</script>
