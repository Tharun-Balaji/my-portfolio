---
import { assetPath } from "../../utils/assets";
---

<section class="hero-layout" id="hero">
  <div class="hero-copy">
    <div class="system-pill">
      <span></span>
      AVAILABLE FOR UI SYSTEMS
    </div>

    <h1 class="hero-title">
      THARUN
      <br />
      <span>BALAJI</span>
    </h1>

    <p class="hero-description">
      Building expressive web interfaces and resilient full-stack applications with a systems-first
      mindset.
    </p>

    <div class="hero-actions">
      <a class="action-button" href="#projects">
        View Projects
        <span class="material-symbols-outlined">rocket_launch</span>
      </a>

      <a class="ghost-button" href="#writing">Read Notes</a>
    </div>
  </div>

  <div class="hero-portrait-wrap">
    <div class="terminal-panel portrait-panel">
      <div class="terminal-header">
        <span>Profile // Ambient Systems</span>
        <span class="material-symbols-outlined portrait-header-icon">filter_center_focus</span>
      </div>

      <div class="portrait-frame">
        <img
          src={assetPath("hero/MyPhoto.png")}
          alt="Portrait of Tharun Balaji"
          class="portrait-mask"
          loading="eager"
          decoding="async"
        />
        <div class="scanline"></div>

        <div class="portrait-dossier">
          <div>
            <span>Signal:</span>
            <strong>0xTB-1102</strong>
          </div>
          <div>
            <span>Base:</span>
            <strong>COIMBATORE_IN</strong>
          </div>
          <div>
            <span>Focus:</span>
            <strong>INTERFACE_ENG</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="portrait-glow"></div>
  </div>
</section>
