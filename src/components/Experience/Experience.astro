---
import history from "../../data/history.json";
---

<section class="section-shell" id="experience">
  <div class="section-header" data-reveal="up">
    <div>
      <span class="eyebrow">HISTORY // CAREER_LOGS</span>
      <h2 class="section-heading">Operational experience that now feeds how I build software.</h2>
      <p class="section-copy">
        My professional background began in structured enterprise workflows, reporting, and asset
        operations. That experience still shapes how I think about clarity, handoffs, and reliable
        systems.
      </p>
    </div>
    <div class="section-rule"></div>
  </div>

  <div class="timeline" data-reveal="up" id="timeline-wrapper">
    <div class="timeline__rail">
      <div class="timeline__rail-active" id="timeline-progress"></div>
    </div>

    <div class="timeline__list">
      {
        history.map((item, index) => (
          <article class="timeline__item" data-reveal={index % 2 === 0 ? "left" : "right"}>
            <span class="timeline__node"></span>
            <div class="terminal-panel timeline__card">
              <div class="panel-header">
                <span>
                  {item.startDate} - {item.endDate}
                </span>
                <span>{item.organization.toUpperCase()}</span>
              </div>

              <div class="timeline__card-body">
                <h3>{item.role}</h3>
                <p class="timeline__org">{item.organization}</p>

                <ul class="timeline__bullets">
                  {item.experiences.map((experience) => <li>{experience}</li>)}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.getElementById("timeline-wrapper");
    const progress = document.getElementById("timeline-progress");
    if (!wrapper || !progress) {
      return;
    }

    const updateProgress = () => {
      const rect = wrapper.getBoundingClientRect();
      const viewportAnchor = window.innerHeight * 0.7;
      const filled = Math.min(Math.max(viewportAnchor - rect.top, 0), rect.height);
      progress.style.height = `${filled}px`;
    };

    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
    updateProgress();
  });
</script>
