---
import history from "../../data/history.json";

const highlights: Record<string, string> = {
  "HAM SME": "30% reduction in manual effort through automation support",
  Trainee: "Completed training with a 4/5 performance rating",
};
---

<section class="section section--surface" id="experience">
  <div class="section__inner">
    <div class="section-head" data-reveal="up">
      <p class="section-head__kicker">Experience</p>
      <h2 class="section-head__title">Outcome-first career story.</h2>
      <p class="section-head__copy">
        The experience section stays concise and anchored in what changed, not just what the role
        description said.
      </p>
    </div>

    <div class="timeline" data-reveal="up">
      {
        history.map((item) => (
          <article class="timeline__item">
            <div class="timeline__year">{item.startDate.split(",")[1]?.trim() ?? item.startDate}</div>
            <div class="timeline__body">
              <h3>{item.role}</h3>
              <p class="timeline__meta">{item.organization} · {item.startDate} - {item.endDate}</p>
              <p class="timeline__copy">{item.experiences[0]}</p>
              <span class="timeline__highlight">{highlights[item.role] ?? item.experiences[item.experiences.length - 1]}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
