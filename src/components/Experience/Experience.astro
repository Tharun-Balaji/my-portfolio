---
import history from "../../data/history.json";
---

<section class="section-shell section-gap" id="experience">
  <div class="section-head">
    <h2>HISTORY</h2>
    <div class="section-line"></div>
  </div>

  <div class="timeline-container" id="timeline-wrapper">
    <svg class="timeline-svg" viewBox="0 0 20 1000" preserveAspectRatio="none" aria-hidden="true">
      <line class="timeline-path" x1="8" x2="8" y1="0" y2="1000"></line>
      <line class="timeline-path-active" id="active-path" x1="8" x2="8" y1="0" y2="0"></line>
    </svg>

    <div class="timeline-list">
      {
        history.map((item) => (
          <div class="timeline-item reveal-item">
            <div class="node-point"></div>
            <div class="timeline-item__content">
              <div class="timeline-item__intro">
                <span>{`${item.startDate} — ${item.endDate}`}</span>
                <h3>{item.role}</h3>
                <p>{item.organization}</p>
              </div>

              <p class="timeline-item__summary">
                {item.experiences[0]}
              </p>

              <div class="timeline-item__tags">
                {item.experiences.slice(1, 3).map((experience) => <div class="sub-node">{experience}</div>)}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const activePath = document.getElementById("active-path");
    const timelineWrapper = document.getElementById("timeline-wrapper");

    const updateTimeline = () => {
      if (!(activePath instanceof SVGLineElement) || !timelineWrapper) {
        return;
      }

      const rect = timelineWrapper.getBoundingClientRect();
      const totalHeight = timelineWrapper.scrollHeight;
      const progress = Math.min(Math.max(window.innerHeight * 0.7 - rect.top, 0), totalHeight);
      activePath.setAttribute("y2", String(progress));
    };

    window.addEventListener("scroll", updateTimeline, { passive: true });
    window.addEventListener("resize", updateTimeline);
    updateTimeline();
  });
</script>
