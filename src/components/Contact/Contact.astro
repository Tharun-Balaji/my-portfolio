---
import styles from "./Contact.module.css";
import { assetPath } from "../../utils/assets";
---

<footer id="contact" class={styles.container}>
  <div class={styles.text}>
    <h2>Contact</h2>
    <p>Feel free to reach out!</p>
  </div>
  <ul class={styles.links}>
    <li class={styles.link}>
      <img src={assetPath("contact/emailIcon.png")} alt="Email Icon" />
      <a href="mailto:tharunbalaji110@gmail.com">tharunbalaji110@gmail.com</a>
    </li>
    <li class={styles.link}>
      <img src={assetPath("contact/linkedinIcon.png")} alt="LinkedIn Icon" />
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://www.linkedin.com/in/tharun-balaji-j-a65402260/"
      >
        linkedin.com/tharun-balaji
      </a>
    </li>
    <li class={styles.link}>
      <img src={assetPath("contact/githubIcon.png")} alt="GitHub Icon" />
      <a href="https://github.com/Tharun-Balaji">github.com/Tharun-Balaji</a>
    </li>
  </ul>
</footer>
