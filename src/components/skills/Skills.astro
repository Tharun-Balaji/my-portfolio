---
const workSkills = [
  {
    title: "React + TypeScript",
    note: "Daily driver for component systems, state, and interface polish.",
    level: "Expert",
  },
  {
    title: "React Native",
    note: "Cross-platform product work with a frontend-first mindset.",
    level: "Expert",
  },
  {
    title: "Next.js / Astro",
    note: "Rendering tradeoffs, content delivery, and app structure.",
    level: "Expert",
  },
  {
    title: "Node.js + APIs",
    note: "Enough backend fluency to ship product work end to end.",
    level: "Proficient",
  },
  {
    title: "WebGL / Three.js",
    note: "Used carefully and only when the experience earns the cost.",
    level: "Careful",
  },
];

const labTools = ["Bun", "Rust", "Tauri", "Expo", "Drizzle", "SQLite", "Supabase", "tRPC", "Zod"];
---

<section class="section" id="skills">
  <div class="section__inner">
    <div class="section-head" data-reveal="up">
      <p class="section-head__kicker">Skills & Lab</p>
      <h2 class="section-head__title">Production confidence with room for curiosity.</h2>
      <p class="section-head__copy">
        Left is what I trust in production. Right is what I reach for when I'm building for myself.
      </p>
    </div>

    <div class="skill-layout" data-reveal="up">
      <article class="skill-panel">
        <p class="skill-panel__kicker">Work Skills</p>
        <div class="skill-list">
          {
            workSkills.map((skill) => (
              <div class="skill-list__item">
                <div>
                  <h3>{skill.title}</h3>
                  <p>{skill.note}</p>
                </div>
                <span class={`skill-badge skill-badge--${skill.level.toLowerCase()}`}>{skill.level}</span>
              </div>
            ))
          }
        </div>
      </article>

      <article class="skill-panel">
        <p class="skill-panel__kicker">Tools Lab</p>
        <div class="tool-grid">
          {labTools.map((tool) => <div class="tool-chip">{tool}</div>)}
        </div>
        <div class="tool-note">Last shipped with Tauri + Rust + React while building desktop experiments and utility apps.</div>
      </article>
    </div>
  </div>
</section>
