---
import skills from "../../data/skills.json";
import { assetPath } from "../../utils/assets";
---

<section class="section-shell" id="stack">
  <div class="section-header" data-reveal="up">
    <div>
      <span class="eyebrow">CORE_STACK // DNA_SEQ</span>
      <h2 class="section-heading">Capabilities grouped by how I actually build.</h2>
      <p class="section-copy">
        Instead of listing tools in a wall of icons, this section maps the stack into the working
        modes that show up repeatedly across my portfolio projects.
      </p>
    </div>
    <div class="section-rule"></div>
  </div>

  <div class="skill-stack">
    {
      skills.map((skill, index) => (
        <details
          class="skill-accordion"
          data-reveal="up"
          data-skill-accordion
          open={index === 0}
        >
          <summary class="skill-accordion__summary">
            <div class="skill-accordion__meta">
              <div class="skill-accordion__icon">
                <img
                  src={assetPath(skill.imageSrc)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div>
                <span class="skill-accordion__serial">TAG_{String(index + 1).padStart(2, "0")}</span>
                <h3>{skill.title}</h3>
              </div>
            </div>

            <span class="skill-accordion__chevron">+</span>
          </summary>

          <div class="skill-accordion__content">
            <p>{skill.summary}</p>
            <div class="chip-row">
              {skill.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const accordions = Array.from(
      document.querySelectorAll<HTMLDetailsElement>("[data-skill-accordion]"),
    );
    accordions.forEach((accordion) => {
      accordion.addEventListener("toggle", () => {
        if (!accordion.open) {
          return;
        }

        accordions.forEach((otherAccordion) => {
          if (otherAccordion !== accordion) {
            otherAccordion.open = false;
          }
        });
      });
    });
  });
</script>
