<aside class="assistant" aria-label="Portfolio assistant">
  <div class="assistant__panel" id="assistant-panel">
    <div class="assistant__header">
      <div class="assistant__avatar">TB</div>
      <div>
        <p class="assistant__name">Tharun's AI</p>
        <p class="assistant__status">Usually responds instantly</p>
      </div>
      <button class="assistant__close" id="assistant-close" type="button" aria-label="Close assistant">×</button>
    </div>
    <div class="assistant__messages" id="assistant-messages">
      <div class="assistant__message">
        Ask about my work, availability, or which projects best show how I think.
      </div>
    </div>
    <div class="assistant__prompts">
      <button class="assistant__prompt" type="button">What makes Tharun stand out?</button>
      <button class="assistant__prompt" type="button">Most complex technical challenge?</button>
      <button class="assistant__prompt" type="button">Is he available right now?</button>
      <button class="assistant__prompt" type="button">Best projects to look at?</button>
    </div>
  </div>

  <button class="assistant__toggle" id="assistant-toggle" type="button" aria-expanded="false">
    <span class="assistant__ping"></span>
    <span>+</span>
  </button>
</aside>

<script>
  const panel = document.getElementById("assistant-panel");
  const toggle = document.getElementById("assistant-toggle");
  const closeButton = document.getElementById("assistant-close");
  const messages = document.getElementById("assistant-messages");
  const prompts = document.querySelectorAll(".assistant__prompt");

  const replies: Record<string, string> = {
    "What makes Tharun stand out?":
      "I work at the intersection of interface polish, product thinking, and implementation detail. I care about the last 10 percent that makes software feel considered, not just complete.",
    "Most complex technical challenge?":
      "The hardest work has been building across the stack while keeping the frontend experience coherent. I enjoy projects where state, performance, and clarity all have to stay aligned at the same time.",
    "Is he available right now?":
      "Yes, I'm open to full-time frontend roles and happy to talk through product-facing engineering work. The fastest path is still email: tharunbalaji110@gmail.com.",
    "Best projects to look at?":
      "Start with the Book My Show clone for end-to-end product flow, then the chat app for real-time interaction, and the car showcase for a cleaner presentation-first build.",
  };

  const setOpen = (open: boolean) => {
    panel?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  const appendMessage = (text: string, isUser = false) => {
    if (!messages) return;

    const item = document.createElement("div");
    item.className = `assistant__message${isUser ? " assistant__message--user" : ""}`;
    item.textContent = text;
    messages.appendChild(item);
    messages.scrollTop = messages.scrollHeight;
  };

  toggle?.addEventListener("click", () => {
    const open = !panel?.classList.contains("is-open");
    setOpen(open);
  });

  closeButton?.addEventListener("click", () => setOpen(false));

  prompts.forEach((prompt) => {
    prompt.addEventListener("click", () => {
      const question = prompt.textContent?.trim() ?? "";
      if (!question) return;

      appendMessage(question, true);
      window.setTimeout(() => appendMessage(replies[question] ?? "Email me at tharunbalaji110@gmail.com and I'll reply directly."), 220);
    });
  });
</script>
