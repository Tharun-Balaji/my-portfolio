---
import styles from "./About.module.css";
import { assetPath } from "../../utils/assets";
---

<section class={styles.container} id="about">
  <h2 class={styles.title}>About</h2>
  <div class={styles.flx}>
    <img src={assetPath("about/MyPhoto.png")} alt="myImage" class={styles.aboutImage} />
    <div class={styles.aboutItem}>
      <div class={styles.aboutItemText}>
        <p>
          Hi, I'm Tharun from Coimbatore. I graduated with a B.Sc. in Mathematics in 2022 and have
          been immersed in asset management at Cognizant Technical Solutions for the past 17
          months.I am on a transformative journey to become a Full Stack Software Developer. I'm
          actively engaged in upskilling through Scaler, honing my abilities to craft innovative and
          robust solutions. Explore my journey and projects here.
        </p>
      </div>
    </div>
  </div>
</section>
