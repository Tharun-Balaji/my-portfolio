---
const takes = [
  "Premature abstraction is the real enemy, not code duplication.",
  "Performance is UX, even when the gain is subtle.",
  "Pragmatism beats purity when the product is on the line.",
  "Type systems are documentation that compiles.",
];

const obsessions = [
  "React architecture and where state actually belongs",
  "Tauri apps that feel native across operating systems",
  "Motion that earns its frame budget",
  "Writing that is honest instead of impressive",
];
---

<section class="section" id="about">
  <div class="section__inner about-grid">
    <div data-reveal="left">
      <p class="section-head__kicker">About</p>
      <h2 class="about__title">
        I think in <span>systems</span>, sweat the final 10%, and treat every interaction like a
        contract.
      </h2>
      <p class="about__copy">
        I graduated in Mathematics, spent 17 months in asset management at Cognizant, and moved
        deeper into software through deliberate project work and focused upskilling. What pulls me
        in now is the seam between product thinking and implementation: the interface details,
        performance decisions, and structural choices that make something feel complete.
      </p>
      <div class="take-list">
        {takes.map((take) => <article class="take-card"><p>{take}</p></article>)}
      </div>
    </div>

    <div class="about-side" data-reveal="right">
      <article class="info-card">
        <p class="info-card__kicker">Currently obsessing over</p>
        <div class="info-stack">
          {obsessions.map((item) => <p class="info-card__item">{item}</p>)}
        </div>
      </article>

      <article class="info-card">
        <p class="info-card__kicker">How I work</p>
        <p class="info-card__body">
          I like interfaces that feel considered, systems that scale without drama, and code that
          stays readable after the excitement of shipping is gone.
        </p>
      </article>

      <article class="info-card info-card--soft">
        <p class="info-card__kicker">Built with intention</p>
        <p class="info-card__body">
          Astro for delivery, a dark editorial layout for clarity, and motion used carefully so the
          experience still holds up when the effects are gone.
        </p>
      </article>
    </div>
  </div>
</section>
