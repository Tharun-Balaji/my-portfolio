---
import { assetPath } from "../../utils/assets";
---

<section class="px-4 py-10 sm:px-6 lg:px-10" id="about" data-reveal="left">
  <div
    class="mx-auto grid w-full max-w-6xl gap-8 rounded-2xl border-2 border-neon-cyan bg-neon-ink/90 p-6 shadow-card lg:grid-cols-[1fr_1.5fr] lg:items-center lg:p-10"
  >
    <img
      src={assetPath("about/MyPhoto.png")}
      alt="Tharun profile"
      class="retro-image w-full rounded-xl border-2 border-neon-pink object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="space-y-4">
      <h2 class="font-display text-2xl uppercase text-neon-cyan sm:text-3xl">About Me</h2>
      <p class="text-base leading-relaxed text-neon-cream sm:text-lg">
        I&apos;m Tharun from Coimbatore. I graduated with a B.Sc. in Mathematics in 2022 and worked
        in asset management at Cognizant Technical Solutions for 17 months. My current direction is
        full stack development, where I combine structured problem-solving with modern web product
        execution.
      </p>
      <p class="text-base leading-relaxed text-neon-cream sm:text-lg">
        I&apos;m actively upskilling through Scaler and building projects that stretch both backend
        logic and frontend craft. This portfolio highlights that shift.
      </p>
    </div>
  </div>
</section>
